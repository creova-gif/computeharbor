# ComputeHarbor Runtime Environment Variables (Example)
# Copy this file to `.env` for local development and replace placeholder values.
# Never commit `.env` or real credentials to version control.

# --- Control Plane & Client Authentication ---
# Optional Bearer API key for `computeharbor serve` (`-api-key`), CLI (`status`, `savings`, `serve`),
# and the Python worker client (`computeharbor_worker.client`).
COMPUTEHARBOR_API_KEY=replace-with-your-api-key

# Default organization identifier sent in the `X-Org-ID` header for tenant-scoped requests.
COMPUTEHARBOR_ORG_ID=org-demo

# Base URL of the ComputeHarbor HTTP control plane.
COMPUTEHARBOR_URL=http://127.0.0.1:8080

# --- Lifecycle Webhooks ---
# Optional HTTP endpoint for asynchronous job lifecycle events (`-webhook-url`).
COMPUTEHARBOR_WEBHOOK_URL=https://example.com/webhooks/computeharbor

# HMAC-SHA256 signing secret used to compute `X-ComputeHarbor-Signature` (`-webhook-secret`).
COMPUTEHARBOR_WEBHOOK_SECRET=replace-with-your-webhook-secret

# --- Cloud Object Store / AWS Credentials (Optional) ---
# Standard AWS SDK credentials when replicating checkpoints to S3-compatible object storage.
AWS_ACCESS_KEY_ID=replace-with-aws-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-access-key
AWS_DEFAULT_REGION=us-east-1
